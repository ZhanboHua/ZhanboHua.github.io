---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Links | ${config.site.title}`}
  description="Places to find Zhanbo Hua and StellarStay online."
>
  <Header />
  <Main pageTitle="Links" pageDesc="A few useful places around the web.">
    <ul class="space-y-6">
      <li>
        <a
          class="text-accent text-lg font-medium hover:underline"
          href="https://github.com/ZhanboHua"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub Profile
        </a>
        <p>Open-source projects and development activity.</p>
      </li>
      <li>
        <a class="text-accent text-lg font-medium hover:underline" href="/">
          StellarStay
        </a>
        <p>Notes on data, AI, engineering, and experiments.</p>
      </li>
    </ul>
  </Main>
  <Footer />
</Layout>
